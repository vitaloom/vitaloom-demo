{
  "info": {
    "_postman_id": "bada0b8b-4f0a-4dc2-9c68-520f59f98124",
    "name": "VitaLoom Demo - Health Ingestion API",
    "description": "Sequential API verification for the current backend slice. Run the entire collection in Collection Runner. Tests use a new testRunId each run. Current baseUrl defaults to http://localhost.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "01 - Health check and initialize test run",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/health"
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const runId = \"postman-\" + Date.now() + \"-\" + Math.random().toString(36).slice(2, 8);",
              "pm.collectionVariables.set(\"testRunId\", runId);",
              "pm.collectionVariables.set(\"occurredAt1\", new Date(Date.now() - 60000).toISOString());",
              "pm.collectionVariables.set(\"occurredAt2\", new Date(Date.now() - 30000).toISOString());",
              "pm.collectionVariables.set(\"occurredAt3\", new Date().toISOString());",
              "pm.collectionVariables.set(\"stepId1\", runId + \"-step-1\");",
              "pm.collectionVariables.set(\"stepId2\", runId + \"-step-2\");",
              "pm.collectionVariables.set(\"heartId1\", runId + \"-hr-1\");",
              "pm.collectionVariables.set(\"heartId2\", runId + \"-hr-2\");",
              "pm.collectionVariables.set(\"atomicId\", runId + \"-atomic\");",
              "pm.collectionVariables.set(\"intraId\", runId + \"-intra\");",
              "",
              "pm.collectionVariables.set(\"waterId1\", runId + \"-water-1\");",
              "pm.collectionVariables.set(\"waterId2\", runId + \"-water-2\");",
              "pm.collectionVariables.set(\"waterAt1\", new Date(Date.now() - 20000).toISOString());",
              "pm.collectionVariables.set(\"waterAt2\", new Date(Date.now() - 10000).toISOString());"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Health endpoint returns HTTP 200\", () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.test(\"Backend and database report UP\", () => {",
              "  pm.expect(body.status).to.eql(\"UP\");",
              "  pm.expect(body.database).to.eql(\"UP\");",
              "});",
              "pm.test(\"Test run IDs have been initialized\", () => {",
              "  pm.expect(pm.collectionVariables.get(\"testRunId\")).to.be.a(\"string\").and.not.empty;",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "02 - Ingest valid steps batch",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/steps/batch",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"runId\": \"{{testRunId}}\",\n  \"events\": [\n    {\n      \"eventId\": \"{{stepId1}}\",\n      \"occurredAt\": \"{{occurredAt1}}\",\n      \"stepsDelta\": 12\n    },\n    {\n      \"eventId\": \"{{stepId2}}\",\n      \"occurredAt\": \"{{occurredAt2}}\",\n      \"stepsDelta\": 8\n    }\n  ]\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Valid steps batch returns 202\", () => pm.response.to.have.status(202));",
              "const body = pm.response.json();",
              "pm.test(\"Both step events are accepted\", () => {",
              "  pm.expect(body.runId).to.eql(pm.collectionVariables.get(\"testRunId\"));",
              "  pm.expect(body.received).to.eql(2);",
              "  pm.expect(body.accepted).to.eql(2);",
              "  pm.expect(body.duplicates).to.eql(0);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "03 - Retry identical steps batch (idempotency)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/steps/batch",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"runId\": \"{{testRunId}}\",\n  \"events\": [\n    {\n      \"eventId\": \"{{stepId1}}\",\n      \"occurredAt\": \"{{occurredAt1}}\",\n      \"stepsDelta\": 12\n    },\n    {\n      \"eventId\": \"{{stepId2}}\",\n      \"occurredAt\": \"{{occurredAt2}}\",\n      \"stepsDelta\": 8\n    }\n  ]\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Retry returns 202\", () => pm.response.to.have.status(202));",
              "const body = pm.response.json();",
              "pm.test(\"Retry inserts no additional records\", () => {",
              "  pm.expect(body.received).to.eql(2);",
              "  pm.expect(body.accepted).to.eql(0);",
              "  pm.expect(body.duplicates).to.eql(2);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "04 - Reuse step event ID with changed payload (conflict)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/steps/batch",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"runId\": \"{{testRunId}}\",\n  \"events\": [\n    {\n      \"eventId\": \"{{stepId1}}\",\n      \"occurredAt\": \"{{occurredAt1}}\",\n      \"stepsDelta\": 99\n    }\n  ]\n}",
          "options": {
            "raw": {
