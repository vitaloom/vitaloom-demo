      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Changed payload with an existing event ID returns 409\", () => pm.response.to.have.status(409));",
              "pm.test(\"Error code identifies event ID conflict\", () => {",
              "  pm.expect(pm.response.json().error.code).to.eql(\"EVENT_ID_CONFLICT\");",
              "});"
            ]
          }
        }
      ]
    },
