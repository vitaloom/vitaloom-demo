          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"A 501-event batch returns 400\", () => pm.response.to.have.status(400));",
              "pm.test(\"Batch limit is reported as validation error\", () => {",
              "  pm.expect(pm.response.json().error.code).to.eql(\"VALIDATION_ERROR\");",
              "});"
            ]
          }
        }
      ]
