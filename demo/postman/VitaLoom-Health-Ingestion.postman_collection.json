          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const base = Date.now();",
              "const events = Array.from({ length: 501 }, (_, i) => ({",
              "  eventId: pm.collectionVariables.get(\"testRunId\") + \"-oversize-\" + i,",
              "  occurredAt: new Date(base + i).toISOString(),",
              "  stepsDelta: 1",
              "}));",
              "pm.collectionVariables.set(\"oversizedEvents\", JSON.stringify(events));"
            ]
          }
        },
