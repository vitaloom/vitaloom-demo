          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Previously uncommitted event can now be inserted\", () => pm.response.to.have.status(202));",
              "const body = pm.response.json();",
              "pm.test(\"Validation happened before any writes\", () => {",
              "  pm.expect(body.received).to.eql(1);",
              "  pm.expect(body.accepted).to.eql(1);",
              "  pm.expect(body.duplicates).to.eql(0);",
              "});"
            ]
          }
        }
      ]
    },
